rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Podcasts storage
    // Note: Quota is enforced by Cloud Function after upload completes
    // This allows uploads to succeed, then function verifies quota and deletes file if exceeded
    match /podcasts/{userId}/{filename} {
      // Allow authenticated users to read/delete their own files
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // Allow upload if:
      // - User is authenticated and matches userId
      // - File size is under 500 MB
      // - File is audio content type
      // Quota enforcement happens post-upload via onPodcastUploaded Cloud Function
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 500 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
    }
  }
}

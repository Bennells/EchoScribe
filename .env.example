# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin (Server-side)
# For local development with emulator: leave empty
# For production: use Workload Identity (no service account needed)
FIREBASE_ADMIN_PROJECT_ID=your_project_id

# Stripe Configuration
# Get test keys from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_... # Use sk_live_... for production

# Stripe Webhook Secret
# FOR LOCALHOST: Get this from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#                Copy the whsec_... secret from the command output
# FOR PRODUCTION: Get this from Stripe Dashboard > Webhooks > [Your endpoint] > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard > Products)
# Create these products in your Stripe account:
# - Starter: €9.99/month (15 podcasts/month)
# - Professional: €24.99/month (60 podcasts/month)
# - Business: €49.99/month (150 podcasts/month)
STRIPE_PRICE_ID_STARTER_MONTHLY=price_...
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_ID_BUSINESS_MONTHLY=price_...

# Note: Stripe Tax is hardcoded in the code (disabled for Kleinunternehmer § 19 UStG)
# See: app/api/stripe/create-checkout-session/route.ts
# To enable VAT later: Change 'enableStripeTax = false' to 'true'

# Development Setup:
# 1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
# 2. Login: stripe login
# 3. Run in two terminals:
#    Terminal 1: npm run dev
#    Terminal 2: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 4. Copy the webhook secret from Terminal 2 to STRIPE_WEBHOOK_SECRET above
# 5. Restart dev server to pick up the new secret
#
# See STRIPE_DEVELOPMENT_SETUP.md for detailed instructions

# Sentry Configuration (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Environment
NODE_ENV=development
